{
  "name": "AIAlert",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "risk_warning",
        "overdue_alert",
        "incident_pattern",
        "compliance_gap",
        "sop_outdated",
        "kpi_breach",
        "reminder"
      ],
      "description": "Lo\u1ea1i c\u1ea3nh b\u00e1o"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "auto_created": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "resolved"
      ],
      "default": "active"
    },
    "related_entity": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "actions_taken": {
      "type": "string"
    },
    "acknowledged_by": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "type",
    "title",
    "message"
  ]
}