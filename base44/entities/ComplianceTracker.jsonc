{
  "name": "ComplianceTracker",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "T\u00ean h\u1ed3 s\u01a1 / thi\u1ebft b\u1ecb theo d\u00f5i"
    },
    "category": {
      "type": "string",
      "enum": [
        "equipment_inspection",
        "environment",
        "training",
        "fire_safety",
        "license"
      ],
      "default": "equipment_inspection"
    },
    "last_done_date": {
      "type": "string",
      "format": "date",
      "description": "Ng\u00e0y th\u1ef1c hi\u1ec7n g\u1ea7n nh\u1ea5t"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Ng\u00e0y h\u1ebft h\u1ea1n"
    },
    "evidence_file_uri": {
      "type": "string",
      "description": "URI file b\u1eb1ng ch\u1ee9ng (private storage)"
    },
    "evidence_file_name": {
      "type": "string"
    },
    "issuing_authority": {
      "type": "string",
      "description": "C\u01a1 quan/\u0110\u01a1n v\u1ecb c\u1ea5p/\u0110o\u00e0n thanh tra"
    },
    "renewal_owner": {
      "type": "string",
      "description": "Ng\u01b0\u1eddi ph\u1ee5 tr\u00e1ch gia h\u1ea1n"
    },
    "linked_clause_code": {
      "type": "string",
      "description": "M\u00e3 ngh\u0129a v\u1ee5 li\u00ean k\u1ebft (LegalClause.clause_code)"
    },
    "notes": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "item_name",
    "category"
  ]
}