{
  "name": "AIToolDefinition",
  "type": "object",
  "properties": {
    "tool_name": {
      "type": "string",
      "description": "T\u00ean \u0111\u1ecbnh danh tool (unique), v\u00ed d\u1ee5: create_incident_report"
    },
    "display_name": {
      "type": "string",
      "description": "T\u00ean hi\u1ec3n th\u1ecb ti\u1ebfng Vi\u1ec7t"
    },
    "description": {
      "type": "string",
      "description": "M\u00f4 t\u1ea3 m\u1ee5c \u0111\u00edch tool"
    },
    "input_schema": {
      "type": "object",
      "description": "JSON Schema \u0111\u1ecbnh ngh\u0129a c\u00e1c tham s\u1ed1 \u0111\u1ea7u v\u00e0o"
    },
    "output_schema": {
      "type": "object",
      "description": "JSON Schema \u0111\u1ecbnh ngh\u0129a c\u1ea5u tr\u00fac k\u1ebft qu\u1ea3 tr\u1ea3 v\u1ec1"
    },
    "automation_level": {
      "type": "string",
      "enum": [
        "FULL_AUTO",
        "NEEDS_REVIEW",
        "NEEDS_APPROVAL"
      ],
      "default": "NEEDS_REVIEW",
      "description": "M\u1ee9c \u0111\u1ed9 t\u1ef1 \u0111\u1ed9ng h\u00f3a"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "B\u1eadt/t\u1eaft tool"
    }
  },
  "required": [
    "tool_name",
    "display_name",
    "automation_level"
  ]
}